<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/question_bg"
    android:padding="24dp">

    <!-- Title / Header -->
    <TextView
        android:id="@+id/tvCategoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHOOSE CATEGORY"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#00FFFF"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvCategorySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a topic to start the cyber quiz"
        android:textSize="14sp"
        android:textColor="#A0A0A0"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvCategoryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Categories Container (LinearLayout for Buttons) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvCategorySubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- GK Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCategoryGK"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="General Knowledge (GK)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_tech_bg"
            app:backgroundTint="@null"
            android:layout_marginBottom="16dp" />

        <!-- Aptitude Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCategoryAptitude"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Aptitude &amp; Reasoning"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_tech_bg"
            app:backgroundTint="@null"
            android:layout_marginBottom="16dp" />

        <!-- Coding Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCategoryCoding"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Software &amp; Coding"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_tech_bg"
            app:backgroundTint="@null"
            android:layout_marginBottom="16dp" />

        <!-- English Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCategoryEnglish"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="English &amp; Communication"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_tech_bg"
            app:backgroundTint="@null" />

    </LinearLayout>

    <!-- Footer Signature -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Design by\n Ankur"
        android:textColor="#707070"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>