<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

<corners
    android:radius="12dp" />

    <!-- शानदार ग्रेडिएंट कलर (डार्क ब्लू से ब्राइट सियान/नीला) -->
    <gradient
        android:startColor="#0A2540"
        android:centerColor="#0083B0"
        android:endColor="#00E5FF"
        android:angle="135" />

    <!-- बटन के चारों तरफ पतली चमकती हुई बॉर्डर (Stroke) -->
    <stroke
        android:width="2dp"
        android:color="#00FFFF" />

</shape>